<!-- Imaging Model Selection Panel - Independent from authoring -->
<div class="model-selection-panel" id="model-selection-panel">
    <div class="panel-header" onclick="toggleModelSelectionAccordion()">
        <h4 id="model-title">Model Selection: Loading...</h4>
        <i class="fas fa-chevron-up" id="model-accordion-icon"></i>
    </div>
    
    <div class="panel-content" id="model-accordion-content">
        <!-- Model Selection -->
        <div class="image-model-selection" id="image-model-selection">
            <label for="image-model-select">Image Generation Model:</label>
            <select id="image-model-select" name="image_model">
                <option value="sdxl-lora">SDXL LoRA (Local)</option>
                <option value="dall-e-3">DALL-E 3 (OpenAI)</option>
                <option value="dall-e-2">DALL-E 2 (OpenAI)</option>
            </select>
        </div>

        <!-- Model Parameters -->
        <div class="model-parameters" id="parameters-container">
            <!-- Parameters will be populated dynamically based on selected model -->
        </div>

        <!-- Action Buttons -->
        <div class="model-actions">
            <button type="button" id="generate-image-btn" class="btn btn-primary">
                <i class="fas fa-magic"></i> Generate Image
            </button>
        </div>
    </div>
</div>

<style>
.model-selection-panel {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 1rem;
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    cursor: pointer;
    border-bottom: 1px solid #334155;
}

.panel-header h4 {
    color: #e2e8f0;
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
}

.panel-header i {
    color: #94a3b8;
    transition: transform 0.2s ease;
}

.panel-content {
    padding: 1rem;
}

.image-model-selection {
    margin-bottom: 1rem;
}

.image-model-selection label {
    display: block;
    color: #e2e8f0;
    margin-bottom: 0.5rem;
    font-weight: 500;
}

.image-model-selection select {
    width: 100%;
    padding: 0.5rem;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 4px;
    color: #e2e8f0;
}

.model-parameters {
    margin-bottom: 1rem;
}

.parameter-group {
    margin-bottom: 0.75rem;
}

.parameter-group label {
    display: block;
    color: #e2e8f0;
    margin-bottom: 0.25rem;
    font-weight: 500;
    font-size: 0.9rem;
}

.parameter-group select,
.parameter-group input {
    width: 100%;
    padding: 0.4rem;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 4px;
    color: #e2e8f0;
    font-size: 0.9rem;
}

.model-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
}

.btn {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s ease;
    font-size: 0.9rem;
}

.btn-primary {
    background: #3b82f6;
    color: white;
}

.btn-primary:hover {
    background: #2563eb;
}

.btn-primary:disabled {
    background: #64748b;
    cursor: not-allowed;
}
</style>

