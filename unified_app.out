9, 13814, 7301, 596, 17864, 389, 24156, 1877, 323, 10026, 9764, 13, 578, 42254, 8881, 27927, 37635, 389, 1380, 3268, 323, 3278, 596, 12908, 304, 19627, 10560, 220, 330, 98673, 794, 837, 198, 633, 9290, 430, 1418, 279, 4652, 1587, 5916, 389, 1063, 13970, 13878, 11, 1202, 5357, 374, 810, 389, 1510, 4455, 323, 19225, 4819, 28987, 19627, 13, 578, 16997, 5578, 5573, 315, 220, 21, 13, 22, 14, 605, 15151, 430, 279, 4652, 706, 264, 24070, 2237, 315, 41961, 311, 27188, 28948, 2971, 10745, 505, 264, 41470, 71764, 13356, 13], 'total_duration': 3128246792, 'load_duration': 87609667, 'prompt_eval_count': 1784, 'prompt_eval_duration': 846642875, 'eval_count': 224, 'eval_duration': 2193332333}
