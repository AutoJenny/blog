, 4028, 1455, 15696, 1606, 433, 596, 15871, 922, 1510, 4455, 323, 4947, 42254, 11, 449, 2697, 41961, 311, 27188, 28948, 477, 7829, 505, 264, 41470, 71764, 13356, 13], 'total_duration': 2922279250, 'load_duration': 86315167, 'prompt_eval_count': 1763, 'prompt_eval_duration': 845771458, 'eval_count': 205, 'eval_duration': 1989721709}
