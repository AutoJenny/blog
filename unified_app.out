, 502, 27306, 13077, 323, 15238, 23468, 3585, 13, 578, 27188, 10423, 596, 11006, 27053, 1202, 15507, 311, 47594, 20792, 11704, 1418, 22973, 279, 3158, 596, 5933, 13444, 13, 6104, 420, 2447, 1253, 8935, 2254, 10977, 11, 433, 1587, 539, 617, 2167, 41961, 311, 27188, 28948, 477, 7829, 11951, 10560, 262, 330, 98673, 794, 905, 198, 633, 5159, 33811, 374, 430, 279, 4652, 24400, 389, 264, 1510, 1567, 449, 7347, 13970, 2317, 477, 13042, 26431, 369, 279, 27188, 41470, 71764, 13, 578, 32714, 311, 15347, 79270, 11573, 527, 3062, 369, 2254, 32083, 323, 7100, 4500, 11, 719, 814, 656, 539, 6089, 5536, 27188, 28948, 477, 7829, 13], 'total_duration': 3358818667, 'load_duration': 88484333, 'prompt_eval_count': 1728, 'prompt_eval_duration': 827390458, 'eval_count': 251, 'eval_duration': 2442440209}
