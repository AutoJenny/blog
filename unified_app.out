, 18352, 3141, 1040, 15185, 1458, 1761, 21458, 1114, 8735, 1124, 15090, 29510, 29481, 5123, 14662, 29491, 8485, 781, 3055, 1113, 26458, 23529, 2032, 1113, 1782, 6215, 23857, 1040, 5610, 17332, 1411, 2212, 29185, 1062, 1072, 29139, 7337, 15185, 29493, 1032, 9700, 21525, 12637, 20775, 1065, 28170, 29510, 29481, 3577, 11223, 29493, 1163, 2328, 15185, 6257, 12749, 27409, 2122, 13481, 9354, 6094, 1077, 9959, 781, 3055, 1113, 1035, 7890, 2032, 1900, 781, 29520], 'total_duration': 5757121375, 'load_duration': 23166625, 'prompt_eval_count': 1821, 'prompt_eval_duration': 1972941917, 'eval_count': 244, 'eval_duration': 3760355167}
