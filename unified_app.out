, 35434, 279, 6020, 3649, 315, 5897, 12576, 3600, 627, 12, 31597, 12939, 374, 3428, 2533, 1070, 527, 912, 5199, 5054, 26006, 5552, 311, 19627, 596, 3938, 9932, 382, 90170, 512, 791, 4652, 22020, 279, 1948, 12, 16933, 27188, 5897, 28424, 11, 449, 19036, 445, 1994, 10118, 21764, 520, 279, 1948, 13, 4452, 11, 369, 264, 41470, 71764, 10877, 8173, 304, 872, 330, 820, 3224, 1359, 420, 3446, 374, 14090, 922, 7100, 3649, 4856, 1109, 27927, 13042, 477, 13970, 26431, 382, 697, 8532, 25, 905], 'total_duration': 2965750583, 'load_duration': 85510916, 'prompt_eval_count': 1795, 'prompt_eval_duration': 859698708, 'eval_count': 207, 'eval_duration': 2020074125}
