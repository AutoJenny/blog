, 279, 38298, 11871, 304, 220, 2366, 21, 11, 719, 433, 596, 10213, 10968, 389, 1510, 4455, 13, 1102, 29727, 389, 19627, 596, 3347, 20256, 315, 279, 11871, 323, 279, 3363, 596, 3766, 20256, 304, 220, 679, 19, 11, 719, 430, 596, 1405, 279, 13970, 2802, 10548, 13, 578, 4652, 706, 1063, 13042, 41961, 449, 1202, 6420, 315, 43997, 439, 264, 27188, 3363, 11, 719, 8244, 433, 596, 810, 922, 279, 1567, 5196, 1109, 1202, 13042, 26431, 10560, 262, 330, 20960, 33906, 794, 330, 791, 38298, 11871, 690, 471, 311, 43997, 304, 220, 2366, 21, 1306, 1694, 26765, 3131, 4245, 311, 2853, 10742, 13, 578, 3953, 690, 4668, 220, 605, 10034, 323, 1935, 2035, 520, 3116, 37278, 11, 449, 279, 8736, 22260, 13847, 369, 5887, 220, 1419, 6634, 13, 1115, 15785, 279, 2132, 892, 43997, 706, 21685, 279, 1567, 11, 2768, 264, 31790, 15220, 2373, 315, 279, 3953, 304, 220, 679, 19, 10560, 262, 330, 98673, 794, 905, 198, 633, 5159, 33811, 374, 430, 1418, 279, 4652, 5825, 1063, 13970, 2317, 922, 43997, 20256, 279, 38298, 11871, 11, 433, 596, 10213, 10968, 389, 1510, 4455, 323, 3250, 956, 82845, 19662, 1139, 19627, 596, 3925, 477, 13042, 26431, 13, 578, 4652, 706, 1063, 9099, 7100, 41961, 439, 264, 3682, 6625, 1567, 690, 4461, 617, 459, 5536, 389, 32083, 304, 43997, 11, 719, 8244, 11, 433, 596, 810, 315, 264, 14348, 15061, 3754, 3446, 1109, 2555, 430, 1053, 387, 8104, 9959, 311, 279, 41470, 71764, 4029, 13], 'total_duration': 3989749583, 'load_duration': 73052166, 'prompt_eval_count': 1788, 'prompt_eval_duration': 860080875, 'eval_count': 311, 'eval_duration': 3056097833}
