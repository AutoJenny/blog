948, 627, 9, 3489, 404, 8050, 2802, 25, 6104, 539, 48298, 68232, 11, 279, 4652, 5825, 459, 7185, 9392, 389, 264, 12309, 9987, 13189, 315, 27188, 13042, 3925, 627, 9, 23362, 12939, 25, 76212, 7100, 26431, 374, 9932, 11, 439, 279, 57105, 315, 279, 37712, 1587, 539, 617, 264, 2167, 5536, 389, 41470, 71764, 8752, 627, 9, 31597, 12939, 25, 578, 4652, 1587, 539, 6420, 904, 5199, 5054, 26006, 477, 25127, 369, 19627, 596, 3938, 382, 28589, 11, 1418, 279, 4652, 2643, 539, 387, 6089, 9959, 311, 41470, 71764, 13016, 6, 7446, 6439, 11, 433, 5825, 12190, 13970, 323, 13042, 26431, 430, 690, 4461, 14638, 311, 1884, 8173, 304, 27188, 28948, 13], 'total_duration': 4880176625, 'load_duration': 85262875, 'prompt_eval_count': 1819, 'prompt_eval_duration': 873813042, 'eval_count': 395, 'eval_duration': 3920563000}
