, 9, 3489, 404, 8050, 2802, 374, 24070, 320, 1135, 8, 1606, 1418, 13929, 2418, 3059, 596, 17219, 311, 17958, 56620, 77, 596, 63306, 574, 19018, 11, 433, 2643, 539, 387, 315, 4040, 2802, 311, 41470, 71764, 13016, 889, 527, 810, 10968, 389, 29924, 4731, 323, 27188, 7829, 627, 9, 23362, 12939, 374, 3428, 320, 20, 8, 1606, 1070, 374, 912, 6420, 315, 7100, 26431, 477, 32083, 5552, 311, 279, 1567, 627, 9, 31597, 12939, 374, 3428, 320, 868, 8, 439, 1070, 374, 912, 10430, 315, 5054, 26006, 11, 3567, 3294, 11, 477, 24589, 304, 12976, 311, 279, 5178, 382, 28589, 11, 1418, 279, 4652, 29727, 389, 13042, 28948, 323, 29924, 4731, 11, 433, 37856, 5199, 13970, 11, 7100, 11, 477, 5054, 2317, 430, 1053, 387, 315, 2802, 311, 41470, 71764, 13016, 13], 'total_duration': 5122789375, 'load_duration': 75244625, 'prompt_eval_count': 1797, 'prompt_eval_duration': 859304791, 'eval_count': 422, 'eval_duration': 4187767625}
