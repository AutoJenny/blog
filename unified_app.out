32, 1113, 17561, 2096, 3370, 20681, 1228, 14260, 1065, 2480, 28170, 5788, 1122, 1040, 1675, 1495, 1158, 1032, 3667, 1066, 18172, 2706, 9268, 10025, 11125, 29493, 28585, 11269, 29481, 1163, 18485, 23365, 1072, 1658, 1061, 2774, 29476, 13052, 2027, 1158, 19884, 1261, 1579, 1642, 29481, 9959, 781, 3055, 1113, 1035, 7890, 2032, 2109, 781, 29520], 'total_duration': 5548854375, 'load_duration': 21229041, 'prompt_eval_count': 1817, 'prompt_eval_duration': 1970231875, 'eval_count': 231, 'eval_duration': 3556249875}
