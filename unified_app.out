6, 7734, 6131, 1163, 13620, 2027, 27870, 29491, 9721, 2712, 29493, 1040, 6215, 4110, 1042, 19814, 1070, 2630, 9195, 29493, 1458, 1597, 1115, 3366, 1158, 6632, 1065, 4239, 1070, 15090, 29510, 29481, 3179, 1385, 9959, 781, 3055, 1113, 26458, 23529, 2032, 1113, 29570, 2649, 29481, 6355, 1573, 4107, 17875, 2603, 1032, 9511, 1065, 26738, 2706, 1150, 6386, 29474, 29510, 1037, 29493, 12912, 1056, 1040, 5780, 1120, 1070, 7830, 6671, 1465, 2080, 13060, 1163, 3493, 1046, 24954, 6942, 1245, 1032, 18485, 1658, 1061, 2774, 29476, 11171, 9959, 781, 3055, 1113, 1035, 7890, 2032, 1900, 781, 29520], 'total_duration': 5768498375, 'load_duration': 23911750, 'prompt_eval_count': 1842, 'prompt_eval_duration': 1968467542, 'eval_count': 244, 'eval_duration': 3774825583}
