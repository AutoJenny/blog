, 65351, 648, 13, 16062, 10118, 5355, 2761, 8930, 906, 1101, 16957, 11157, 11, 2737, 389, 813, 220, 1135, 339, 2107, 13, 578, 3243, 374, 961, 315, 19627, 596, 18459, 369, 872, 1828, 2489, 2403, 1561, 17340, 10560, 262, 330, 98673, 794, 905, 198, 633, 9290, 430, 358, 617, 16957, 279, 4652, 12309, 3428, 4028, 682, 15696, 1606, 433, 15871, 24400, 389, 264, 1510, 10034, 1567, 449, 7347, 13970, 477, 13042, 26431, 505, 264, 41470, 71764, 13356, 13], 'total_duration': 3146977375, 'load_duration': 87321167, 'prompt_eval_count': 1787, 'prompt_eval_duration': 857589708, 'eval_count': 225, 'eval_duration': 2201479209}
