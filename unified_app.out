, 21414, 1070, 26010, 27662, 14331, 1042, 1124, 1088, 1617, 15331, 29493, 1458, 1274, 3495, 1032, 5298, 15181, 1122, 2938, 4632, 10274, 12100, 1065, 1164, 21197, 4871, 2712, 4799, 4474, 9485, 29493, 17147, 1845, 1163, 1040, 4355, 29501, 26172, 5298, 28742, 5155, 4120, 18485, 1658, 1061, 2774, 29476, 9959, 781, 3055, 1113, 1035, 7890, 2032, 2109, 781, 29520], 'total_duration': 5568423959, 'load_duration': 24510875, 'prompt_eval_count': 1831, 'prompt_eval_duration': 1966672750, 'eval_count': 232, 'eval_duration': 3576189042}
